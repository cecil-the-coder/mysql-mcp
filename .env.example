# MySQL MCP Server Environment Configuration
# Copy this file to .env and customize the values for your environment.
#
# Configuration precedence (highest to lowest):
#   1. Environment variables (directly exported in shell or Claude config)
#   2. TOML config file (mysql-mcp.toml or $MCP_CONFIG_FILE)
#   3. .env file (this file)
#   4. Built-in defaults

# ─────────────────────────────────────────────────────────────────────────────
# MySQL Connection Settings
# ─────────────────────────────────────────────────────────────────────────────

# MySQL server hostname (default: localhost)
MYSQL_HOST=localhost

# MySQL server port (default: 3306)
MYSQL_PORT=3306

# Unix socket path - takes precedence over host:port when set (optional)
# MYSQL_SOCKET_PATH=/var/run/mysqld/mysqld.sock

# MySQL username (default: root)
MYSQL_USER=root

# MySQL password (default: empty)
MYSQL_PASS=

# Default database to connect to (optional - omit for multi-database mode)
MYSQL_DB=mydatabase

# Full MySQL connection URL (overrides all other connection fields when set)
# Format: mysql://user:password@host:port/database
# MYSQL_CONNECTION_STRING=mysql://root:pass@localhost:3306/mydatabase

# ─────────────────────────────────────────────────────────────────────────────
# Connection Pool Settings
# ─────────────────────────────────────────────────────────────────────────────

# Maximum number of connections in the pool (default: 20)
MYSQL_POOL_SIZE=20

# Per-query timeout in milliseconds (default: 30000)
MYSQL_QUERY_TIMEOUT=30000

# Connection establishment timeout in milliseconds (default: 10000)
MYSQL_CONNECT_TIMEOUT=10000

# Schema introspection cache TTL in seconds - 0 disables caching (default: 60)
MYSQL_CACHE_TTL=60

# Maximum rows returned per query - safety limit for runaway queries (default: 1000)
# LIMIT is automatically appended when queries have no LIMIT clause. Set to 0 to disable.
MYSQL_MAX_ROWS=1000

# Performance hints control when EXPLAIN is run (default: none)
# Valid values: none | auto | always
#   none   - never run EXPLAIN automatically
#   auto   - run EXPLAIN only when query exceeds slow_query_threshold_ms
#   always - run EXPLAIN on every SELECT query
MYSQL_PERFORMANCE_HINTS=none

# Threshold (ms) for auto EXPLAIN when performance_hints=auto (default: 500)
MYSQL_SLOW_QUERY_THRESHOLD_MS=500

# Number of retry attempts for transient network errors (default: 2)
MYSQL_RETRY_ATTEMPTS=2

# Maximum memory in MB for result sets (default: 256)
MYSQL_MAX_RESULT_MEMORY_MB=256

# ─────────────────────────────────────────────────────────────────────────────
# Security Settings (all default to false for read-only access)
# ─────────────────────────────────────────────────────────────────────────────

# Allow INSERT operations (default: false)
MYSQL_ALLOW_INSERT=false

# Allow UPDATE operations (default: false)
MYSQL_ALLOW_UPDATE=false

# Allow DELETE operations (default: false)
MYSQL_ALLOW_DELETE=false

# Allow DDL operations - CREATE, ALTER, DROP, TRUNCATE (default: false)
MYSQL_ALLOW_DDL=false

# Require SSL/TLS for MySQL connections (default: false)
MYSQL_SSL=false

# Skip SSL certificate validation - NOT for production use (default: false)
MYSQL_SSL_ACCEPT_INVALID_CERTS=false

# Path to PEM CA certificate file for SSL verification (optional)
# MYSQL_SSL_CA=/path/to/ca.pem

# Allow runtime connections via mysql_connect tool (default: false)
# When enabled, LLM assistants can create new database connections at runtime
MYSQL_ALLOW_RUNTIME_CONNECTIONS=false

# Maximum concurrent named sessions (default: 50)
MYSQL_MAX_SESSIONS=50

# Maximum total database connections across all sessions (default: 100)
MYSQL_MAX_TOTAL_CONNECTIONS=100

# Per-schema permission overrides (optional)
# Format: comma-separated list of allowed operations (insert, update, delete, ddl)
# Example: allow INSERT and UPDATE only on 'app_db' schema
# MYSQL_SCHEMA_APP_DB_PERMISSIONS=insert,update

# ─────────────────────────────────────────────────────────────────────────────
# SSH Tunnel Settings (optional)
# ─────────────────────────────────────────────────────────────────────────────

# SSH bastion/jump host hostname - enables SSH tunneling when set
# MYSQL_SSH_HOST=bastion.example.com

# SSH server port (default: 22)
MYSQL_SSH_PORT=22

# SSH username on the bastion host
# MYSQL_SSH_USER=ubuntu

# Path to SSH private key file (optional - uses SSH agent if not set)
# MYSQL_SSH_PRIVATE_KEY=/home/user/.ssh/id_rsa

# Host key verification mode (default: strict)
# Valid values: strict | accept-new | insecure
#   strict     - fail if host key is unknown (most secure)
#   accept-new - automatically add new host keys
#   insecure   - skip all host key verification (not recommended)
MYSQL_SSH_KNOWN_HOSTS_CHECK=strict

# Override path to known_hosts file (default: ~/.ssh/known_hosts)
# MYSQL_SSH_KNOWN_HOSTS_FILE=/etc/ssh/known_hosts
